# Public configuration placeholders only. Native Swift does not automatically load .env.
# Step 18 must implement validated native build/runtime configuration.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Resolve these with the user before registering native OAuth callbacks/capabilities.
MACOS_BUNDLE_ID=YOUR_APPROVED_BUNDLE_ID
APPLE_TEAM_ID=YOUR_APPLE_DEVELOPER_TEAM_ID
AUTH_REDIRECT_URL=YOUR_APPROVED_NATIVE_CALLBACK_URL
# Never add service_role, sb_secret keys, signing secrets or provider private keys.
